# Qeet ID hosted login — copy to `.env.local` for local dev (gitignored).
# Next.js inlines NEXT_PUBLIC_* at build; only public values belong here (no secrets).
# Each value below is the local-dev default; the `# prod:` comment is the live value.

# Backend API base URL (the app appends /v1/... itself).
# prod: https://api.id.qeet.in
NEXT_PUBLIC_API_URL=http://localhost:4001

# Optional RUNTIME override of the same public URL, read on each request and
# sent to the browser via /public-config.js — lets one container image serve
# any environment (the qeet-id-deploy test kit sets it). Public, not a secret.
# PUBLIC_API_URL=
