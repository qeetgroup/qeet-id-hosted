{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!bun.lock"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error"
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "API traffic goes through src/platform/api (the client or fetchLoginContext), so CSRF, cookies and errors are handled once."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**/page.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/platform/**", "@/i18n/**"],
                    "message": "A route reads the URL and renders one module page; loading data and building the screen happen in that module."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/i18n/**", "!src/i18n/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/modules/**", "@/platform/**", "@/testing/**"],
                    "message": "i18n/ is the lowest layer: it imports only external packages and its own locale files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/modules/**"],
                    "message": "platform/ is shared by every module, so it can't depend on one: import only @/platform, @/i18n or packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/account/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A module renders pages for src/app; it never imports from it."
                  },
                  {
                    "group": ["@/modules/**", "!@/modules/account/**"],
                    "message": "A module never imports another module: move what both need into src/platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/authentication/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A module renders pages for src/app; it never imports from it."
                  },
                  {
                    "group": ["@/modules/**", "!@/modules/authentication/**"],
                    "message": "A module never imports another module: move what both need into src/platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/enterprise-setup/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A module renders pages for src/app; it never imports from it."
                  },
                  {
                    "group": ["@/modules/**", "!@/modules/enterprise-setup/**"],
                    "message": "A module never imports another module: move what both need into src/platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/oauth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A module renders pages for src/app; it never imports from it."
                  },
                  {
                    "group": ["@/modules/**", "!@/modules/oauth/**"],
                    "message": "A module never imports another module: move what both need into src/platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/recovery/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A module renders pages for src/app; it never imports from it."
                  },
                  {
                    "group": ["@/modules/**", "!@/modules/recovery/**"],
                    "message": "A module never imports another module: move what both need into src/platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/sign-out/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "A module renders pages for src/app; it never imports from it."
                  },
                  {
                    "group": ["@/modules/**", "!@/modules/sign-out/**"],
                    "message": "A module never imports another module: move what both need into src/platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/platform/api/**", "**/__tests__/**", "src/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
